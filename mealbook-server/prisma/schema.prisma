
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User Model
model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  favorites Favorite[]
  plans     MealPlan[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  meals Meal[]
}

// Meal Model
model Meal {
  id           Int              @id @default(autoincrement())
  sourceId     String?          @unique
  name         String
  description  String?
  image        String?
  categoryId   Int?
  area         String?
  tags         String?
  instructions String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  ingredients MealIngredient[]
  favorites   Favorite[]
  plans       MealPlan[]
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

model MealIngredient {
  id        Int    @id @default(autoincrement())
  name      String
  measure   String
  sortOrder Int
  mealId    Int

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([mealId, sortOrder])
  @@index([mealId])
}

// Favorite Model
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  mealId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([userId, mealId])
  @@index([userId])
  @@index([mealId])
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  mealId    Int
  day       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([mealId])
}
